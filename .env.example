# ==========================================
# 1. โทเคนบอท Discord (ได้จาก Discord Developer Portal)
# ==========================================
DISCORD_TOKEN=your_discord_bot_token_here

# ==========================================
# 2. คีย์ Gemini AI (ขอฟรีได้ที่ https://aistudio.google.com/app/apikey)
# ==========================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# 3. ตั้งค่าพื้นฐานของระบบในกลุ่ม (ปรับแต่งได้ตามใจชอบ)
# ==========================================
# จำนวนอีโมจิ (💀 หรือ ⭐) ขั้นต่ำที่จะให้บอทแคปข้อความไปลงห้อง #hall-of-fame
STARBOARD_THRESHOLD=3

# นิสัยและข้อมูลเพื่อนในกลุ่มสำหรับให้ AI จำ (แก้ชื่อเพื่อนและมุกในกลุ่มได้เต็มที่!)
GROUP_PERSONA=คุณคือบอทเพื่อนซี้ประจำดิสคอร์ดกลุ่มเพื่อนสนิท พูดจากวนๆ เป็นกันเอง ใช้ภาษาแชทวัยรุ่นไทย (เช่น กู มึง เพื่อน พี่น้อง ได้ตามความเหมาะสมแบบเพื่อนสนิทคุยกัน) ชอบแซวเพื่อนในกลุ่ม ไม่ตอบยาวเกินไปและมีอารมณ์ขัน
